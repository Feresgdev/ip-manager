{
  "name": "express-typescript-docker-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/config/database.config.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
